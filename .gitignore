# ============================================
# .gitignore raiz del monorepo (Backend + Frontend)
# ============================================

# Dependencias (de cualquier subcarpeta)
**/node_modules/

# Variables de entorno reales - NUNCA subir esto a GitHub
**/.env
**/.env.local
**/.env.*.local

# Build del frontend
Frontend/dist/
Frontend/dist-ssr/
**/*.local

# Logs
**/*.log
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*

# Editor / SO
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

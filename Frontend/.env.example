# Copia este archivo como ".env" y ajustalo segun donde corra tu backend.
# En Vite, las variables que el navegador puede leer DEBEN empezar con VITE_.

# Local (mientras desarrollas, con el backend corriendo en tu PC):
VITE_API_URL=http://localhost:5001/api

# Cuando despliegues a Vercel, cambia esto por la URL real de tu backend en Render, por ejemplo:
# VITE_API_URL=https://nodos-backend.onrender.com/api

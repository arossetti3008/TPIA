# Copia este archivo como ".env" y completa con tus valores reales.
# El archivo ".env" NUNCA debe subirse a GitHub (ya está en .gitignore).

PORT=5000
NODE_ENV=development

# MongoDB Atlas - cadena de conexion del cluster M0 (free tier)
MONGO_URI=mongodb+srv://usuario:password@cluster.mongodb.net/nodos?retryWrites=true&w=majority

# Secreto para firmar JWT - genera uno propio, largo y aleatorio
# Podes generarlo con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=cambia_esto_por_un_secreto_largo_y_aleatorio
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=cambia_esto_por_otro_secreto_distinto
JWT_REFRESH_EXPIRES_IN=7d

# URL del frontend en Vercel, para configurar CORS correctamente
FRONTEND_URL=http://localhost:5173

# API key del proveedor del LLM (Gemini) - conseguila gratis en aistudio.google.com
LLM_API_KEY=tu_api_key_aqui
# Nombre del modelo de Gemini a usar. Los modelos van cambiando con el tiempo
# (Google fue apagando versiones viejas durante 2026), verificalo en
# https://ai.google.dev/gemini-api/docs/models antes de deployar a produccion.
GEMINI_MODEL=gemini-flash-latest
